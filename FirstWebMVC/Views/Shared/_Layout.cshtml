<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FirstWebMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FirstWebMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .system-toggle {
            background: linear-gradient(135deg, #1d4ed8 0%, #0f172a 100%);
            color: #fff !important;
            border: 0;
            border-radius: 999px;
            padding: 0.7rem 1.1rem;
            box-shadow: 0 0.75rem 1.75rem rgba(15, 23, 42, 0.15);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .system-toggle:hover,
        .system-toggle:focus {
            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.22);
        }

        .system-menu {
            min-width: 280px;
            border: 0;
            border-radius: 1rem;
            padding: 0.75rem;
            box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, 0.18);
            animation: fadeIn 0.25s ease-out;
        }

        .dropdown-header {
            letter-spacing: 0.04em;
        }

        .dropdown-item {
            border-radius: 0.8rem;
            transition: all 0.2s ease;
            padding: 0.7rem 0.85rem;
        }

        .dropdown-item:hover {
            transform: translateX(4px);
            background-color: #eff6ff;
            color: #1d4ed8 !important;
        }

        .dropdown-divider {
            opacity: 0.15;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    FirstWebMVC
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Student" asp-action="Index">Students</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Customer" asp-action="Index">Customers</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle system-toggle fw-semibold" 
                               href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-fill me-2"></i> Hệ thống
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end system-menu mt-2">
                                
                                <li><h6 class="dropdown-header text-uppercase fw-bolder text-primary mb-2">Bán hàng</h6></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i>Khách hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2 text-primary"></i>Sản phẩm</a></li>
                                
                                <li><hr class="dropdown-divider mx-3"></li>

                                <li><h6 class="dropdown-header text-uppercase fw-bolder text-success mb-2">Quản lý kho</h6></li>
                                <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck me-2 text-success"></i>Nhà cung cấp</a></li>
                                <li><a class="dropdown-item" asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2 text-success"></i>Loại thiết bị</a></li>
                                <li><a class="dropdown-item" asp-controller="Device" asp-action="Index"><i class="bi bi-laptop me-2 text-success"></i>Thiết bị</a></li>
                                
                                <li><hr class="dropdown-divider mx-3"></li>

                                <li><a class="dropdown-item fw-semibold text-primary" asp-controller="ImportSlip" asp-action="Index">
                                    <i class="bi bi-arrow-down-square-fill me-2"></i>Phiếu Nhập Kho
                                </a></li>
                                <li><a class="dropdown-item fw-semibold text-danger" asp-controller="ExportSlip" asp-action="Index">
                                    <i class="bi bi-arrow-up-square-fill me-2"></i>Phiếu Xuất Kho
                                </a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; 2026 - <b>Tráng Lê Giang - 2221050736</b> - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>