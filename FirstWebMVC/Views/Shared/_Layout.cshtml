<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FirstWebMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FirstWebMVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* Hiệu ứng hover cho menu thêm mượt */
        .dropdown-item { transition: all 0.2s; border-radius: 5px; }
        .dropdown-item:hover { transform: translateX(5px); background-color: #f8f9fa; color: #0d6efd !important; }
        .dropdown-menu { animation: fadeIn 0.3s ease-out; border: none !important; }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    FirstWebMVC
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Student" asp-action="Index">Students</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Customer" asp-action="Index">Customers</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-outline-primary border-2 px-3 fw-bold shadow-sm" 
                               href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-fill me-1"></i> HỆ THỐNG
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg py-3 mt-2" style="min-width: 250px;">
                                
                                <li><h6 class="dropdown-header text-uppercase fw-bolder text-primary">Đơn hàng</h6></li>
                                <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-people me-2"></i>Khách hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Sản phẩm</a></li>
                                
                                <li><hr class="dropdown-divider mx-3"></li>

                                <li><h6 class="dropdown-header text-uppercase fw-bolder text-success">Quản lý kho</h6></li>
                                <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck me-2"></i>Nhà cung cấp</a></li>
                                <li><a class="dropdown-item" asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i>Loại thiết bị</a></li>
                                <li><a class="dropdown-item" asp-controller="Device" asp-action="Index"><i class="bi bi-laptop me-2"></i>Thiết bị</a></li>
                                
                                <li><hr class="dropdown-divider mx-3"></li>

                                <li><a class="dropdown-item text-primary fw-bold" asp-controller="ImportSlip" asp-action="Index">
                                    <i class="bi bi-arrow-down-square-fill me-2"></i>Phiếu Nhập Kho
                                </a></li>
                                <li><a class="dropdown-item text-danger fw-bold" asp-controller="ExportSlip" asp-action="Index">
                                    <i class="bi bi-arrow-up-square-fill me-2"></i>Phiếu Xuất Kho
                                </a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; 2026 - <b>Tráng Lê Giang - 2221050736</b> - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>