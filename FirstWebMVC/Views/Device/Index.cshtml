@model IEnumerable<FirstWebMVC.Models.Entities.Device>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">DANH SÁCH THIẾT BỊ</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-bold">
            + Thêm mới
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-white p-3 border-bottom">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Tìm kiếm:</label>
                </div>
                <div class="col-md-4">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Nhập tên thiết bị..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary shadow-sm">Tìm kiếm</button>
                </div>
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Xem tất cả</a>
                </div>
            </form>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 40%; padding: 12px;">@Html.DisplayNameFor(model => model.DeviceName)</th>
                            <th style="width: 30%; padding: 12px;">Loại thiết bị</th>
                            <th style="width: 30%; padding: 12px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu thiết bị nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model) {
                                <tr>
                                    <td class="align-middle px-4 fw-semibold text-dark">
                                        @Html.DisplayFor(modelItem => item.DeviceName)
                                    </td>
                                    <td class="align-middle px-4 text-center">
                                        <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.Category.CategoryName)</span>
                                    </td>
                                    <td class="text-center align-middle py-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm shadow-sm">Sửa</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white shadow-sm">Chi tiết</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm shadow-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>