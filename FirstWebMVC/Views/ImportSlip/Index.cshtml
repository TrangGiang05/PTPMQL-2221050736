@model IEnumerable<FirstWebMVC.Models.Entities.ImportSlip>

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h4 class="mb-0">LỊCH SỬ NHẬP KHO</h4>
            <a asp-action="Create" class="btn btn-light btn-sm fw-bold shadow-sm text-primary">
                + Lập phiếu mới
            </a>
        </div>
        <div class="card-body p-4">
            
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped shadow-sm">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 15%;">Mã Phiếu</th>
                            <th style="width: 25%;">Ngày Nhập</th>
                            <th style="width: 40%;">Nhà Cung Cấp</th>
                            <th style="width: 20%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Chưa có phiếu nhập kho nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle fw-bold text-primary">PN-@item.Id</td>
                                    <td class="align-middle text-center">@item.ImportDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="align-middle">@item.Supplier?.Name</td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm shadow-sm">Sửa</a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white shadow-sm">Chi tiết</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm shadow-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</div>