@model IEnumerable<FirstWebMVC.Models.Entities.Supplier>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">DANH SÁCH NHÀ CUNG CẤP</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-bold">
            + Thêm mới
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 25%; padding: 12px;">@Html.DisplayNameFor(model => model.Name)</th>
                            <th style="width: 20%; padding: 12px;">@Html.DisplayNameFor(model => model.Phone)</th>
                            <th style="width: 35%; padding: 12px;">@Html.DisplayNameFor(model => model.Address)</th>
                            <th style="width: 20%; padding: 12px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có dữ liệu nhà cung cấp nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model) {
                                <tr>
                                    <td class="align-middle px-4 fw-semibold text-dark">
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td class="align-middle px-4 text-center">
                                        @Html.DisplayFor(modelItem => item.Phone)
                                    </td>
                                    <td class="align-middle px-4">
                                        @Html.DisplayFor(modelItem => item.Address)
                                    </td>
                                    <td class="text-center align-middle py-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm shadow-sm">Sửa</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white shadow-sm">Chi tiết</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm shadow-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
