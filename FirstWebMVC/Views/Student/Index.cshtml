@{
    ViewData["Title"] = "Danh sách Sinh viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Danh sách Sinh viên</h2>

        <div class="bg-light border rounded p-2" style="min-width: 350px;">
            <form asp-action="ImportExcel" asp-controller="Student" method="post" enctype="multipart/form-data" class="m-0">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-success text-white fw-bold">Import Excel</span>
                    <input type="file" class="form-control" name="fileExcel" accept=".xlsx, .xls" required>
                    <button class="btn btn-success" type="submit">Upload</button>
                </div>
                <div class="text-muted mt-1 text-end" style="font-size: 0.8rem; font-style: italic;">
                    * Vui lòng đảm bảo các cột dữ liệu khớp với file mẫu.
                </div>
            </form>
        </div>
    </div>

    <div id="studentTableContainer">
    </div>
</div>

<div id="modalContainer"></div>

@section Scripts {
    <script src="~/js/student/student.js" asp-append-version="true"></script>
    <script src="~/js/student/student-table.js" asp-append-version="true"></script>
    <script src="~/js/student/student-create.js" asp-append-version="true"></script>
    <script src="~/js/student/student-edit.js" asp-append-version="true"></script>
    <script src="~/js/student/student-delete.js" asp-append-version="true"></script>
}