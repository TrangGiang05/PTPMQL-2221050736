@model FirstWebMVC.Models.Entities.Student

@{
    ViewData["Title"] = "Chi tiết Sinh viên";
}

<h2>Chi tiết thông tin Sinh viên</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4 fw-bold">Mã Sinh Viên</dt>
            <dd class="col-sm-8">
                <span class="badge bg-primary text-white fs-6">@Html.DisplayFor(model => model.StudentCode)</span>
            </dd>

            <dt class="col-sm-4 fw-bold">Họ và Tên</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.FullName)</dd>

            <dt class="col-sm-4 fw-bold">Tuổi</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Age)</dd>

            <dt class="col-sm-4 fw-bold">Email</dt>
            <dd class="col-sm-8">
                <a href="mailto:@Model.Email">@Html.DisplayFor(model => model.Email)</a>
            </dd>

            <dt class="col-sm-4 fw-bold">Tên Khoa</dt>
            <dd class="col-sm-8">
                @if (Model.Faculty != null)
                {
                    <span class="badge bg-success">@Model.Faculty.FacultyName</span>
                }
                else
                {
                    <span class="text-muted">Chưa được phân công khoa</span>
                }
            </dd>
        </dl>
    </div>
</div>

<hr />

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.StudentCode" class="btn btn-warning">Sửa</a>
    <a asp-action="Delete" asp-route-id="@Model.StudentCode" class="btn btn-danger">Xóa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>
