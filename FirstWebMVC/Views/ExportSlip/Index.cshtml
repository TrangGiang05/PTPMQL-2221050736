@model IEnumerable<FirstWebMVC.Models.Entities.ExportSlip>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">LỊCH SỬ XUẤT KHO</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-bold">
            + Lập phiếu mới
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered table-striped mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 15%; padding: 12px;">Mã Phiếu</th>
                            <th style="width: 25%; padding: 12px;">Ngày Xuất</th>
                            <th style="width: 40%; padding: 12px;">Người Nhận</th>
                            <th style="width: 20%; padding: 12px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Chưa có phiếu xuất kho nào.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                         {
                                <tr>
                                    <td class="text-center align-middle fw-bold text-danger">PX-@item.Id</td>
                                    <td class="align-middle text-center">@item.ExportDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="align-middle px-4 fw-semibold">@item.ReceiverName</td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm shadow-sm">Sửa</a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white shadow-sm">Chi tiết</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm shadow-sm">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>