@model FirstWebMVC.Models.Entities.Category

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            
            <div class="alert alert-warning text-center shadow-sm" role="alert">
                <h5 class="alert-heading fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill"></i> CẢNH BÁO XÓA!</h5>
                <p class="mb-0">Bạn có chắc chắn muốn xóa loại thiết bị này không? Hành động này không thể hoàn tác.</p>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white p-3">
                    <h4 class="mb-0">XÓA LOẠI THIẾT BỊ</h4>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">
                            Tên loại thiết bị:
                        </dt>
                        <dd class="col-sm-7 fw-bold fs-5 text-dark">
                            @Html.DisplayFor(model => model.CategoryName)
                        </dd>
                    </dl>

                    <hr class="my-4" />

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary px-4">Hủy & Quay lại</a>
                            <button type="submit" class="btn btn-danger px-5 shadow-sm">
                                Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>