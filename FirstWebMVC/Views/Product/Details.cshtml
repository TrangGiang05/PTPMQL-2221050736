@model FirstWebMVC.Models.Entities.Product

@{
    ViewData["Title"] = "Chi tiết Sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm col-md-6 mx-auto">
        <div class="card-header bg-info text-white fw-bold">
            Thông tin chi tiết
        </div>
        <div class="card-body">
            <h5 class="card-title text-primary">@Model.Name</h5>
            <p class="card-text">
                <strong>Mã SP:</strong> @Model.Id <br />
                <strong>Đơn giá:</strong> <span class="text-danger fw-bold">@Model.Price.ToString("N0") đ</span>
            </p>
        </div>
        <div class="card-footer bg-white">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</div>