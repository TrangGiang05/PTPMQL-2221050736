@model IEnumerable<FirstWebMVC.Models.Entities.Product>

@{
    ViewData["Title"] = "Danh sách Sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kho Sản Phẩm</h2>
        <a asp-action="Create" class="btn btn-primary">+ Thêm Sản Phẩm Mới</a>
    </div>

    <table class="table table-hover border shadow-sm">
        <thead class="table-dark">
            <tr>
                <th width="10%">Mã SP</th>
                <th width="50%">Tên Sản phẩm</th>
                <th width="20%">Đơn giá (VNĐ)</th>
                <th width="20%">Thao tác</th> 
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold text-center">@item.Id</td>
                        <td>@item.Name</td>
                        <td class="text-danger fw-bold">@item.Price.ToString("N0") đ</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted fst-italic py-3">
                        Kho hàng đang trống. Hãy thêm sản phẩm mới!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>