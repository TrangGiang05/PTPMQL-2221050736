@model IEnumerable<FirstWebMVC.Models.Entities.Customer>

@{
    ViewData["Title"] = "Danh sách Khách hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách Khách hàng</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm Khách hàng</a>
    </div>

    <table class="table table-hover border shadow-sm">
        <thead class="table-dark">
            <tr>
                <th width="10%">ID</th>
                <th width="35%">Tên khách hàng</th>
                <th width="30%">Số điện thoại</th>
                <th width="25%">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                Xem đơn hàng
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted fst-italic py-3">
                        Chưa có khách hàng nào trong hệ thống.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>