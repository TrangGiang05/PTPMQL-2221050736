@model FirstWebMVC.Models.CustomerOrderHistoryViewModel

@{
    ViewData["Title"] = "Chi tiết Lịch sử Mua hàng";
}

<div class="container mt-4">
    <h2 class="text-primary">Lịch sử Mua hàng</h2>
    <hr />

    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Thông tin Khách hàng</h4>
        </div>
        <div class="card-body">
            <p class="mb-1"><strong>Họ và tên:</strong> @Model.CustomerName</p>
            <p class="mb-0"><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
        </div>
    </div>

    <h4 class="mt-4 mb-3">Danh sách Đơn hàng đã đặt</h4>

    @if (Model.Orders != null && Model.Orders.Any())
    {
        <table class="table table-bordered table-striped table-hover shadow-sm bg-white">
    <thead class="table-dark text-center">
        <tr>
            <th width="15%">Mã Đơn (ID)</th>
            <th width="20%">Ngày mua</th>
            <th width="35%">Sản phẩm bao gồm</th>
            <th width="10%">Số lượng</th> 
            <th width="20%">Tổng tiền (VNĐ)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr class="align-middle">
                <td class="text-center fw-bold text-primary">#@order.OrderId</td>
                <td class="text-center">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                
                <td>
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in order.OrderItems)
                        {
                            <li>• @item.ProductName</li>
                        }
                    </ul>
                </td>

                <td class="text-center">
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in order.OrderItems)
                        {
                            <li class="fw-bold">@item.Quantity</li>
                        }
                    </ul>
                </td>

                <td class="text-danger fw-bold text-end">
                    @order.TotalAmount.ToString("N0") đ
                </td>
            </tr>
        }
    </tbody>
</table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            Khách hàng này hiện tại chưa có đơn hàng nào!
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>