@model FirstWebMVC.Models.Entities.Order

@{
    ViewData["Title"] = "Xóa Đơn hàng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger border-2 shadow-lg rounded" role="alert">
                <h4 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA
                </h4>
                <hr />
                <p class="mb-3">
                    Bạn có chắc chắn muốn xóa đơn hàng này không? <strong>Hành động này không thể hoàn tác.</strong>
                </p>

                <div class="card mb-3 bg-light border-0">
                    <div class="card-body">
                        <p class="mb-2">
                            <strong><i class="bi bi-receipt me-2"></i>Mã Đơn:</strong> #@Model.Id
                        </p>
                        <p class="mb-2">
                            <strong><i class="bi bi-person me-2"></i>Khách hàng:</strong> @Model.Customer?.Name
                        </p>
                        <p class="mb-0">
                            <strong><i class="bi bi-calendar-event me-2"></i>Ngày Mua:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>
                </div>

                <div class="card mb-3 bg-light border-0">
                    <div class="card-header bg-danger text-white fw-bold p-2">
                        <i class="bi bi-cart me-2"></i>Sản phẩm sẽ bị xóa (@(Model.OrderDetails?.Count ?? 0) sản phẩm)
                    </div>
                    <div class="card-body p-2">
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <li class="py-1">
                                        <span class="badge bg-danger">x@item.Quantity</span>
                                        <strong>@item.Product?.Name</strong>
                                        <span class="text-muted">(@item.UnitPrice.ToString("N0") VNĐ)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <hr />

                <form method="post" class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg fw-bold" 
                            onclick="return confirm('Bạn chắc chắn muốn xóa đơn hàng #@Model.Id?')">
                        <i class="bi bi-trash-fill me-2"></i>XÓA ĐƠN HÀNG
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg fw-bold">
                        <i class="bi bi-arrow-left me-2"></i>QUAY LẠI
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
