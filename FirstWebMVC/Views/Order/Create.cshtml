@model FirstWebMVC.Models.CreateOrderViewModel

@{
    ViewData["Title"] = "Tạo Đơn Hàng Mới";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-success text-white text-center py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-cart-plus"></i> Lên Đơn Mua Hàng </h4>
        </div>
        <div class="card-body p-4 bg-light">
            <form asp-action="Create" method="post" id="orderForm">
                
                <!-- PHẦN 1: CHỌN KHÁCH HÀNG -->
                <div class="mb-4">
                    <label asp-for="CustomerId" class="form-label fw-bold fs-5">Chọn Khách Hàng</label>
                    <select asp-for="CustomerId" class="form-select border-primary form-select-lg" asp-items="ViewBag.Customers" id="customerId">
                        <option value="">-- Click để chọn khách hàng --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <!-- PHẦN 2: DANH SÁCH SẢN PHẨM -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label fw-bold fs-5 mb-0">Danh Sách Sản Phẩm Đặt Mua</label>
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="addProductRow()">
                            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
                        </button>
                    </div>

                    <!-- TABLE DANH SÁCH SẢN PHẨM -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="productTable">
                            <thead class="table-success text-center">
                                <tr>
                                    <th style="width: 45%">Sản Phẩm</th>
                                    <th style="width: 20%">Giá (VNĐ)</th>
                                    <th style="width: 20%">Số Lượng</th>
                                    <th style="width: 15%">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="orderItems">
                                <!-- Các dòng sản phẩm sẽ được thêm vào đây -->
                            </tbody>
                        </table>
                    </div>

                    <div id="emptyMessage" class="alert alert-info text-center">
                        <strong>Chưa có sản phẩm nào.</strong> Bấm "Thêm sản phẩm" để bắt đầu!
                    </div>
                </div>

                <!-- PHẦN 3: TỔNG CỘNG & NÚT SUBMIT -->
                <div class="row mb-4">
                    <div class="col-md-6 offset-md-6">
                        <div class="card bg-white border-warning">
                            <div class="card-body text-end">
                                <h5 class="mb-3">
                                    Tổng Cộng: <span id="totalAmount" class="text-success fw-bold fs-4">0 đ</span>
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm" id="submitBtn" disabled>
                        <i class="bi bi-check-circle"></i> Chốt Đơn
                    </button>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary">
                        Hủy bỏ & Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JAVASCRIPT XỬ LÝ -->
<script>
    // Lưu danh sách giá sản phẩm
    const productPrices = @Html.Raw(ViewBag.ProductPrices);
    let rowCount = 0;

    // Thêm dòng sản phẩm mới
    function addProductRow() {
        const orderItems = document.getElementById('orderItems');
        const emptyMessage = document.getElementById('emptyMessage');
        
        // Ẩn thông báo "Chưa có sản phẩm"
        if (orderItems.children.length === 0) {
            emptyMessage.style.display = 'none';
        }

        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <select name="OrderItems[${rowCount}].ProductId" class="form-select form-select-sm product-select" onchange="updatePrice(this)">
                    <option value="">-- Chọn sản phẩm --</option>
                    @foreach (var product in ViewBag.Products as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                    {
                        <option value="@product.Value">@product.Text</option>
                    }
                </select>
            </td>
            <td>
                <span class="product-price text-end d-block">0 đ</span>
            </td>
            <td>
                <input type="number" name="OrderItems[${rowCount}].Quantity" class="form-control form-control-sm quantity-input" 
                       value="1" min="1" max="1000" onchange="updateTotal()">
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProductRow(this)">
                    <i class="bi bi-trash"></i> Xóa
                </button>
            </td>
        `;
        
        orderItems.appendChild(row);
        rowCount++;
        updateTotal();
    }

    // Cập nhật giá khi chọn sản phẩm
    function updatePrice(selectElement) {
        const productId = selectElement.value;
        const row = selectElement.closest('tr');
        const priceSpan = row.querySelector('.product-price');
        
        if (productId && productPrices[productId]) {
            const price = productPrices[productId];
            priceSpan.textContent = price.toLocaleString('vi-VN') + ' đ';
        } else {
            priceSpan.textContent = '0 đ';
        }
        
        updateTotal();
    }

    // Xóa dòng sản phẩm
    function removeProductRow(button) {
        button.closest('tr').remove();
        const orderItems = document.getElementById('orderItems');
        const emptyMessage = document.getElementById('emptyMessage');
        
        // Hiển thị thông báo nếu không còn sản phẩm
        if (orderItems.children.length === 0) {
            emptyMessage.style.display = 'block';
        }
        
        updateTotal();
    }

    // Cập nhật tổng cộng
    function updateTotal() {
        const rows = document.querySelectorAll('#orderItems tr');
        const submitBtn = document.getElementById('submitBtn');
        let total = 0;

        rows.forEach(row => {
            const priceText = row.querySelector('.product-price').textContent;
            const price = parseInt(priceText.replace(/\D/g, '')) || 0;
            const quantity = parseInt(row.querySelector('.quantity-input').value) || 0;
            total += price * quantity;
        });

        document.getElementById('totalAmount').textContent = total.toLocaleString('vi-VN') + ' đ';
        
        // Kích hoạt nút Submit nếu có ít nhất 1 sản phẩm
        submitBtn.disabled = rows.length === 0;
    }

    // Kiểm tra khách hàng được chọn khi submit
    document.getElementById('orderForm').addEventListener('submit', function(e) {
        const customerId = document.getElementById('customerId').value;
        if (!customerId) {
            e.preventDefault();
            alert('Vui lòng chọn khách hàng!');
            return false;
        }

        const rows = document.querySelectorAll('#orderItems tr');
        if (rows.length === 0) {
            e.preventDefault();
            alert('Vui lòng chọn ít nhất 1 sản phẩm!');
            return false;
        }
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}