@model FirstWebMVC.Models.Entities.Order

@{
    ViewData["Title"] = "Sửa Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA ĐƠN HÀNG #@Model.Id
        </h2>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="bi bi-arrow-left"></i> Hủy
        </a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form method="post" class="shadow p-4 rounded bg-light">
                @if (ViewBag.Customers != null)
                {
                    <div class="mb-3">
                        <label for="CustomerId" class="form-label fw-bold">
                            <i class="bi bi-person-badge"></i> Khách hàng
                        </label>
                        <select name="CustomerId" id="CustomerId" class="form-select form-select-lg" required>
                            <option value="">-- Chọn khách hàng --</option>
                            @foreach (var item in ViewBag.Customers)
                            {
                                <option value="@item.Value" selected="@(item.Value.ToString() == Model.CustomerId.ToString())">
                                    @item.Text
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label for="OrderDate" class="form-label fw-bold">
                        <i class="bi bi-calendar-event"></i> Ngày mua
                    </label>
                    <input type="datetime-local" name="OrderDate" id="OrderDate" class="form-control form-control-lg" 
                           value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-sm fw-bold">
                        <i class="bi bi-check-circle me-2"></i>Cập nhật
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg shadow-sm fw-bold">
                        <i class="bi bi-x-circle me-2"></i>Hủy bỏ
                    </a>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle-fill me-2"></i>Thông tin Đơn hàng</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Mã Đơn:</strong> #@Model.Id</p>
                    <p class="mb-2"><strong>Khách hàng:</strong> @Model.Customer?.Name</p>
                    <p class="mb-2"><strong>Số điện thoại:</strong> @Model.Customer?.Phone</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-cart-check me-2"></i>Chi tiết Sản phẩm</h5>
                </div>
                <div class="card-body">
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.OrderDetails)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span><strong>@item.Product?.Name</strong></span>
                                        <span class="badge bg-light text-dark">x@item.Quantity</span>
                                    </div>
                                    <small class="text-muted">@item.UnitPrice.ToString("N0") VNĐ/cái</small>
                                </li>
                            }
                        </ul>
                        <div class="mt-3 pt-3 border-top">
                            <strong>Tổng: @Model.OrderDetails.Sum(od => od.Quantity * od.UnitPrice).ToString("N0") VNĐ</strong>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">Không có sản phẩm nào</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
